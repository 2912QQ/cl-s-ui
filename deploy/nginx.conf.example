# Reverse proxy in front of the panel. Replace the domain, certificate paths,
# the two paths (see `s-ui setting -show` / the panel settings) and the ports.
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    ssl_certificate     /etc/ssl/self-signed.crt;   # any dummy cert
    ssl_certificate_key /etc/ssl/self-signed.key;
    # Unknown host / IP scans get no answer at all.
    return 444;
}

server {
    listen 443 ssl http2;
    server_name panel.example.com;

    ssl_certificate     /etc/letsencrypt/live/panel.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/panel.example.com/privkey.pem;
    server_tokens off;

    # Panel: only the random path is proxied; everything else returns 404.
    location /REPLACE_PANEL_PATH/ {
        proxy_pass http://127.0.0.1:38417;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
    }

    # Subscription endpoint.
    location /REPLACE_SUB_PATH/ {
        proxy_pass http://127.0.0.1:38418;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        return 404;
    }
}
